{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rito.app/schema/fontes.schema.json",
  "title": "Fontes descobertas de um concurso",
  "description": "Saída de 1_descobrir.py e entrada de 2_baixar.py — data/01_fontes/{slug}/fontes.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "descoberto_em", "origem", "arquivos"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "descoberto_em": { "type": "string", "minLength": 10 },
    "origem": {
      "type": "string",
      "description": "URL da página do concurso, ou 'manual' quando os PDFs foram colocados à mão em data/00_manual/{slug}/.",
      "minLength": 1
    },
    "avisos": { "type": "array", "items": { "type": "string" } },
    "arquivos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["papel", "url", "nome"],
        "properties": {
          "papel": {
            "type": "string",
            "enum": ["caderno", "caderno_com_justificativa", "gabarito_definitivo", "gabarito_preliminar", "edital", "desconhecido"]
          },
          "url": { "type": "string", "minLength": 1 },
          "nome": { "type": "string", "minLength": 1 },
          "tipo_caderno": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "local": { "type": "string" }
        }
      }
    }
  }
}
